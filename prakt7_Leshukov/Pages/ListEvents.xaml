<Page x:Class="prakt7_Leshukov.Pages.ListEvents"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:prakt7_Leshukov.Pages"
      mc:Ignorable="d" 
      xmlns:Md="http://materialdesigninxaml.net/winfx/xaml/themes"
      d:DesignHeight="450" d:DesignWidth="800"
      Title="ListEvents">

    <Grid x:Name="grid">
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition Width="250"/>
        </Grid.ColumnDefinitions>
        
            <ListView MouseDoubleClick="ListView_MouseDoubleClick" 
                      SelectedItem="{Binding selected}" ItemsSource="{Binding events}">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>    
                            <TextBlock Text="{Binding Id}"></TextBlock>
                            <TextBlock Text="{Binding Title}"></TextBlock>
                            <TextBlock Text="{Binding Location}"></TextBlock>
                            <TextBlock Text="{Binding EventDate}"></TextBlock>
                            <TextBlock Text="{Binding TicketPrice}"></TextBlock>
                            <TextBlock Text="{Binding IsActive}"></TextBlock>
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
       
        <StackPanel Grid.Column="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="150"/>
                    <RowDefinition Height="150"/>
                    <RowDefinition Height="150"/>
                </Grid.RowDefinitions>
                <StackPanel Orientation="Vertical" VerticalAlignment="Center" Grid.Row="0">
                    <Button Width="200" Click="GetAll">Вывести все</Button>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Margin="0 15 0 15" TextAlignment="Center">ID:</TextBlock>
                        <TextBox Margin="0 10 0 15" Width="100" Md:HintAssist.Hint="" Text="{Binding idGet, UpdateSourceTrigger=LostFocus}"></TextBox>
                    </StackPanel>
                    
                    <Button Width="200" Click="GetOne">Вывести по ID</Button>
                </StackPanel>
                <StackPanel Grid.Row="1">

                    <StackPanel Margin="0 10 0 10" HorizontalAlignment="Center" Orientation="Horizontal">
                        <TextBlock TextAlignment="Center"  Width="100" VerticalAlignment="Center">Активен</TextBlock>
                        <CheckBox VerticalAlignment="Center" Width="30" Md:HintAssist.Hint="" IsChecked="{Binding isActive}" ></CheckBox>
                    </StackPanel>
                    <StackPanel Margin="0 0 0 10" HorizontalAlignment="Center" Orientation="Horizontal">
                        <TextBlock TextAlignment="Center"  Width="50" VerticalAlignment="Center">Место</TextBlock>
                        <TextBox Margin="0 0 0 10"  Width="150" Md:HintAssist.Hint="" Text="{Binding location}"></TextBox>
                    </StackPanel>
                   
                    
                    <Button Width="200" Click="GetAllFilter">Найти</Button>
                    

                   
                </StackPanel>
                <StackPanel VerticalAlignment="Center" Grid.Row="2">

                    <Button Width="200"  Click="Go_to_add">Создать</Button>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock TextAlignment="Center" Margin=" 0 10 0 10">ID:</TextBlock>
                        <TextBox Margin=" 0 5 0 10" Width="100" Md:HintAssist.Hint="" Text="{Binding id}"></TextBox>
                    </StackPanel>
                    
                    <Button Width="200" Click="Delete">Удалить по ID</Button>
                </StackPanel>
            </Grid>
            
            
        </StackPanel>
        
    </Grid>
</Page>
